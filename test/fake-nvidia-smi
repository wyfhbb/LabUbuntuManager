#!/bin/bash
# 假 nvidia-smi：本机没有 NVIDIA 显卡，用它验证 gpu 相关命令的解析与诊断分支。
#
# 输出严格照抄真实 nvidia-smi 的字段顺序（见 cmd/gpu.go 的 gpuStatusQueryFields /
# gpuProcessQueryFields），数值是编造的 —— 真实显卡上的数值需要在有卡的机器上另测。
#
# 场景由环境变量 SMI_SCENARIO 选择：
#   ok（默认）  两张 RTX 4090，其中 0 号卡有两个计算进程
#   idle        两张卡都空闲，无计算进程
#   mismatch    驱动与内核模块版本不一致（apt 升级驱动后没重启，最常见）
#   nodriver    内核模块未加载
#   nodevice    认不到卡（掉卡）
#   noperm      权限不足
#   nvmlunknown NVML 未知错误（容器里常见）
#   hang        卡住不返回（验证 2 秒超时）
#
# gpu top 要把 PID 归属到用户，PID 从 /tmp/fake-gpu-pids 读（每行一个，由 e2e.sh 写）。

SCENARIO=${SMI_SCENARIO:-ok}

case "$SCENARIO" in
mismatch)
    echo "Failed to initialize NVML: Driver/library version mismatch" >&2
    exit 255
    ;;
nodriver)
    echo "NVIDIA-SMI has failed because it couldn't communicate with the NVIDIA driver. Make sure that the latest NVIDIA driver is installed and running." >&2
    exit 9
    ;;
nodevice)
    echo "No devices were found" >&2
    exit 6
    ;;
noperm)
    echo "Failed to initialize NVML: Insufficient Permissions" >&2
    exit 255
    ;;
nvmlunknown)
    echo "Failed to initialize NVML: Unknown Error" >&2
    exit 255
    ;;
hang)
    # exec 换掉自己：超时后被 kill 的就是这个 sleep 本身，
    # 否则 bash 被杀而 sleep 变孤儿，管道不关闭，调用方要等满 5 秒
    exec sleep 5
    ;;
esac

UUID0=GPU-11111111-1111-1111-1111-111111111111
UUID1=GPU-22222222-2222-2222-2222-222222222222

mapfile -t PIDS < <(cat /tmp/fake-gpu-pids 2>/dev/null)
PID_A=${PIDS[0]:-1}
PID_B=${PIDS[1]:-1}
PID_GONE=${PIDS[2]:-999999}

case "$1" in
--query-gpu=*)
    if [ "$SCENARIO" = idle ]; then
        echo "0, $UUID0, 24564, 2, 24562, 0, 32, 21.30, 450.00, 550.54.14, NVIDIA GeForce RTX 4090"
        echo "1, $UUID1, 24564, 2, 24562, 0, 31, 20.80, 450.00, 550.54.14, NVIDIA GeForce RTX 4090"
    else
        echo "0, $UUID0, 24564, 20480, 4084, 96, 71, 402.15, 450.00, 550.54.14, NVIDIA GeForce RTX 4090"
        echo "1, $UUID1, 24564, 1024, 23540, 12, 45, 98.60, 450.00, 550.54.14, NVIDIA GeForce RTX 4090"
    fi
    ;;
--query-compute-apps=*)
    [ "$SCENARIO" = idle ] && exit 0
    echo "$UUID0, $PID_A, 19456, /home/zhangsan/miniforge3/envs/torch/bin/python train.py --dataset a,b"
    echo "$UUID1, $PID_B, 1024, /usr/bin/python3"
    echo "$UUID0, $PID_GONE, 512, /opt/already-exited"
    ;;
-q)
    echo "==============NVSMI LOG=============="
    echo "Driver Version                        : 550.54.14"
    echo "CUDA Version                          : 12.4"
    ;;
esac
exit 0
